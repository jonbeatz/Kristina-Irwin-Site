# =============================================================================
# Kristina-Irwin-Site — Environment (copy to .env.local)
# Bootstrap merges JonBeatz master keys automatically. NEVER commit .env.local.
# Full registry: ENV-VARS-REFERENCE.md
# =============================================================================

# Mem0 — isolated per project
MEM0_USER_ID=kristina-irwin-site
MEM0_COLLECTION=kristina-irwin-site_memories
MEM0_QDRANT_PATH=%USERPROFILE%\.mem0\qdrant_kristina-irwin-site
MEM0_API_KEY=REPLACE_WITH_MEM0_API_KEY
MEM0_LM_MODEL=qwen3-4b-instruct-2507
MEM0_JSON_SCHEMA=false

# Hermes profile
HERMES_PROFILE_NAME=Kristina-Irwin-Site
HERMES_PROFILE_SLUG=kristina-irwin-site

# DeepSeek / LiteLLM / ngrok — see JonBeatz master or ENV-VARS-REFERENCE.md
# TELEGRAM_* / MCP tokens / HOSTINGER_* / DRAVEN_* — merged on bootstrap

# Hostinger site paths (set before first deploy)
KRISTINA_IRWIN_SITE_DOMAIN=kristina-irwin-site.dev
KRISTINA_IRWIN_SITE_WEB_ROOT=REPLACE_WITH_REMOTE_WEB_ROOT
KRISTINA_IRWIN_SITE_APP_ROOT=REPLACE_WITH_REMOTE_APP_ROOT
KRISTINA_IRWIN_SITE_DEPLOY_METHOD=hostinger-node
FTP_REMOTE_PATH=/nodejs/kristina-irwin-site

# Backup
PROFILE_BACKUP_ROOT=G:\Hermes_Project_BackUpz\Kristina-Irwin-Site

# Voice
DRAVEN_VOICE_POLICY=ritual
DRAVEN_VOICE_ERRORS=1

# Image / ComfyUI (shared workstation — opt-in)
COMFYUI_ROOT=H:\AI_Models\ComfyUI
COMFYUI_PORT=8188
COMFYUI_HOST=127.0.0.1
COMFYUI_WORKFLOWS_DIR=H:\AI_Models\ComfyUI\workflows
MSC_COMFY_SCRIPTS=D:\Cursor_Projectz\MyStudioChannel\.cursor\custom-scriptz
IMAGE_OUTPUT_DIR=D:\Hermes\assets\media\Kristina-Irwin-Site
COMFYUI_AUTO_START=0
# HF_TOKEN=  # Hugging Face cloud image:gen
# FAL_API_KEY=  # fal.ai paid image:fal
# FAL_IMAGE_MODEL=fal-ai/flux/schnell

